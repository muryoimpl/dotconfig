[
  {
    "output": ["DP-1", "HDMI-A-1", "DP-2"],
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    // eDP-1 のバーに合わせて 32。#custom-power が 170% で要求高 32px になるため、
    // 30 のままだと外部出力を繋いだときにバーが自動で広がってしまう
    "height": 32, // Waybar height (to be removed for auto height)
    "spacing": 1, // Gaps between modules (4px)
    "margin": 0,
    "modules-left": [
      "mango/workspaces",
      "tray",
      "wlr/taskbar"
    ],
    "modules-center": [
      "mango/layout",
      "mango/window"
    ],
    "modules-right": ["pulseaudio", "network", "cpu", "memory", "disk", "temperature", "clock", "custom/notification", "custom/power"],
    "mango/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "on-click-right": "toggle",
        "overview-label": "OVERVIEW",
    },
    "mango/window": {
      "format": "{title}",
      "icon-size": 20
    },
    "mango/layout": {
        "format": "[{symbol}] ",
    },
    "tray": {
        "icon-size": 18,
        "spacing": 5
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon}  {volume}% {format_source}", "format-bluetooth": "{volume}% {icon}ᚼᛒ{format_source}",
        "format-bluetooth-muted": "🔇{icon}ᚼᛒ{format_source}",
        "format-muted": "🔇 {format_source}",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "🎧",
            "hands-free": "🎧",
            "headset": "🎧",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "tooltip": true,
        "tooltip-format": "{icon}  {volume}% \n{format_source}"
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": " ",
        "format-ethernet": "🌐",
        "tooltip-format": "🖧 {essid} ({signalStrength}%) {ifname} via {gwaddr}",
        "tooltip-format-wifi": "  {essid} ({signalStrength}%) {ifname} via {gwaddr}",
        "tooltip-format-ethernet": "🌐 {ipaddr}/{cidr}",
        "format-linked": "🖧 {ifname} (No IP)",
        "format-disconnected": " ⚠ Disconnected",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "cpu": {
        "format": ":{usage}%",
        "interval": 1,
        "tooltip": true
    },
    "memory": {
        "format": ":{}%",
        "interval": 1,
        "tooltip": true,
        "tooltip-format": "Memory: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB ({swapPercentage}%)"
    },
    "disk": {
      "interval": 30,
      "format": "🖴:{percentage_used}%",
      "path": "/"
    },
    "temperature": {
        // "thermal-zone": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon0/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "M.2: {icon} {temperatureC}°C",
        "format-icons": ["🆒", "🌡️", "🥵"]
    },
    "clock": {
        "timezone": "Asia/Tokyo",
        "tooltip": true,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%Y-%m-%d(%a) %H:%M}",
        "format-alt": "{:%Y-%m-%d(%a) %H:%M}",
        "interval": 1,
        "locale": "ja_JP.UTF-8",
        "calendar": {
            "start-day": "sunday",
            "mode"          : "year",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "",
            "on-scroll"     : 1,
            "on-click-right": "mode",
            "format": {
                "months":     "<span color='#d3c6aa'><b>{}</b></span>",
                "days":       "<span color='#e67e80'>{}</span>",
                "weeks":      "<span color='#a7c080'><b>W{}</b></span>",
                "weekdays":   "<span color='#7fbbb3'><b>{}</b></span>",
                "today":      "<span color='#dbbc7f'><b><u>{}</u></b></span>"
            }
        }
    },
    "custom/notification": {
      "tooltip": true,
      "format": "<span size='12pt'>{icon}</span>",
      "format-icons": {
        "notification": "🔔",
        "none": "",
        "dnd-notification": "🔕",
        "dnd-none": "🔕",
        "inhibited-notification": "🔕",
        "inhibited-none": "🔕",
        "dnd-inhibited-notification": "🔕",
        "dnd-inhibited-none": "🔕",
      },
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "escape": true,
    },
    "custom/power": {
      "tooltip-format": "Power Menu",
      "on-click": "wlogout & disown",
      "format": "󰐥"
    }
  },
  {
    "output": ["DP-3"],
    "layer": "top",
    "position": "top",
    // 他のバーと同じく 32 (理由は DP-1 側のコメント参照)
    "height": 32,
    "spacing": 1,
    "mergin": 0,
    "modules-left": [
      "mango/workspaces",
      "tray",
      "wlr/taskbar"
    ],
    "modules-center": [
      "mango/layout",
      "mango/window"
    ],
    "modules-right": ["cpu", "memory", "disk", "temperature", "clock", "custom/notification"],
    "mango/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "on-click-right": "toggle",
        "overview-label": "OVERVIEW",
    },
    "mango/window": {
      "format": "{title}",
      "icon-size": 20
    },
    "mango/layout": {
        "format": "[{symbol}] ",
    },
    "tray": {
        "icon-size": 18,
        "spacing": 5
    },
    "cpu": {
        "format": ":{usage}%",
        "interval": 1,
        "tooltip": true
    },
    "memory": {
        "format": ":{}%",
        "interval": 1,
        "tooltip": true,
        "tooltip-format": "Memory: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB ({swapPercentage}%)"
    },
    "disk": {
      "interval": 30,
      "format": "🖴:{percentage_used}%",
      "path": "/"
    },
    "temperature": {
        // "thermal-zone": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon0/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "M.2: {icon} {temperatureC}°C",
        "format-icons": ["🆒", "🌡️", "🥵"]
    },
    "clock": {
        "timezone": "Asia/Tokyo",
        "tooltip": true,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%Y-%m-%d(%a) %H:%M}",
        "format-alt": "{:%Y-%m-%d(%a) %H:%M}",
        "interval": 1,
        "locale": "ja_JP.UTF-8",
        "calendar": {
            "start-day": "sunday",
            "mode"          : "year",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "",
            "on-scroll"     : 1,
            "on-click-right": "mode",
            "format": {
                "months":     "<span color='#d3c6aa'><b>{}</b></span>",
                "days":       "<span color='#e67e80'>{}</span>",
                "weeks":      "<span color='#a7c080'><b>W{}</b></span>",
                "weekdays":   "<span color='#7fbbb3'><b>{}</b></span>",
                "today":      "<span color='#dbbc7f'><b><u>{}</u></b></span>"
            }
        }
    },
   "custom/notification": {
      "tooltip": true,
      "format": "<span size='12pt'>{icon}</span>",
      "format-icons": {
        "notification": "🔔",
        "none": "",
        "dnd-notification": "🔕",
        "dnd-none": "🔕",
        "inhibited-notification": "🔕",
        "inhibited-none": "🔕",
        "dnd-inhibited-notification": "🔕",
        "dnd-inhibited-none": "🔕",
      },
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "on-click": "sway-client -t -sw",
      "on-click-right": "sway-client -d -sw",
      "escape": true
    }
  },
  {
    "output": ["eDP-1"],
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 32, // Waybar height (to be removed for auto height)
    "spacing": 1, // Gaps between modules (4px)
    "margin": 0,
    "modules-left": [
      "battery",
      "mango/workspaces",
      "tray",
      "wlr/taskbar"
    ],
    "modules-center": [
      "mango/layout",
      "mango/window"
    ],
    "modules-right": ["backlight", "pulseaudio", "network", "cpu", "memory", "disk", "clock", "custom/noctalia-bar", "custom/caffeine", "custom/notification", "group/power"],
    "battery": {
      "interval": 60,
      "states": {
          "good": 95,
          "warning": 20,
          "critical": 10
      },
      "format": "{capacity}% {icon}",
      "format-icons": ["", "", "", "", ""],
      "format-charging": "{capacity}% {icon}",
      "format-plugged ": "{icon}",
      "max-length": 25
    },
    "mango/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "on-click-right": "toggle",
        "overview-label": "OVERVIEW",
    },
    "mango/window": {
      "format": "{title}",
      "icon-size": 20
    },
    "mango/layout": {
        "format": "[{symbol}] ",
    },
    "tray": {
        "icon-size": 18,
        "spacing": 5
    },
    "backlight": {
      "device": "amdgpu_bl1",
      "format": "{icon}  {percent}%",
      "format-icons": ["󱩎", "󱩖"],
      "on-scroll-up": "brightnessctl set +5%",
      "on-scroll-down": "brightnessctl set 5%-",
      "on-click": "brightnessctl set +5%",
      "on-click-right": "brightnessctl set 5%-"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon}  {volume}% {format_source}", "format-bluetooth": "{volume}% {icon}ᚼᛒ{format_source}",
        "format-bluetooth-muted": "🔇{icon}ᚼᛒ{format_source}",
        "format-muted": "🔇 {format_source}",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "🎧",
            "hands-free": "🎧",
            "headset": "🎧",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "tooltip": true,
        "tooltip-format": "{icon}  {volume}% \n{format_source}"
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": " ",
        "format-ethernet": "🌐",
        "tooltip-format": "🖧 {essid} ({signalStrength}%) {ifname} via {gwaddr}",
        "tooltip-format-wifi": "  {essid} ({signalStrength}%) {ifname} via {gwaddr}",
        "tooltip-format-ethernet": "🌐 {ipaddr}/{cidr}",
        "format-linked": "🖧 {ifname} (No IP)",
        "format-disconnected": " ⚠ Disconnected",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "cpu": {
        "format": ":{usage}%",
        "interval": 1,
        "tooltip": true
    },
    "memory": {
        "format": ":{}%",
        "interval": 1,
        "tooltip": true,
        "tooltip-format": "Memory: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB ({swapPercentage}%)"
    },
    "disk": {
      "interval": 30,
      "format": "🖴:{percentage_used}%",
      "paths": "/"
    },
    "clock": {
        "timezone": "Asia/Tokyo",
        "tooltip": true,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%Y-%m-%d(%a) %H:%M}",
        "format-alt": "{:%Y-%m-%d(%a) %H:%M}",
        "interval": 1,
        "locale": "ja_JP.UTF-8",
        "calendar": {
            "start-day": "sunday",
            "mode"          : "year",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "",
            "on-scroll"     : 1,
            "on-click-right": "mode",
            "format": {
                "months":     "<span color='#d3c6aa'><b>{}</b></span>",
                "days":       "<span color='#e67e80'>{}</span>",
                "weeks":      "<span color='#a7c080'><b>W{}</b></span>",
                "weekdays":   "<span color='#7fbbb3'><b>{}</b></span>",
                "today":      "<span color='#dbbc7f'><b><u>{}</u></b></span>"
            }
        }
    },
    // クリックで performance -> balanced -> power-saver を巡回する。
    // 実体は tlp-pd (TLP の power-profiles-daemon 互換 D-Bus API)。
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip": true,
      "tooltip-format": "Power profile: {profile}\nCPU driver: {cpu_driver}\nPlatform driver: {platform_driver}",
      "format-icons": {
        "default": "󰾅",
        "performance": "󰓅",
        "balanced": "󰾅",
        "power-saver": "󰾆"
      }
    },
    // 電源系 (パワープロファイル + ファン + 電源メニュー) を畳んで
    // 1 ボタン分に収める。
    // drawer は先頭のモジュールだけ残して他を隠し、左クリックで展開する。
    //
    // 入口を専用のアイコンにしているのは、drawer が展開のクリックを食っても
    // 「grouped modules may still process their own on-click events」で leader
    // 自身の on-click も走るため。power-profiles-daemon はクリックを自前処理
    // する (on-click を受け付けない) ので、これを先頭にすると開くたびに
    // プロファイルが巡回してしまう。
    //
    // caffeine は状態を常に見たいのでグループに入れず独立させている。
    // ファンは同じ「機体の回し方」の設定なので power-profiles-daemon の
    // 隣に入れた。畳むと手動固定中かどうかが見えなくなるが、fan-profile.sh の
    // 温度セーフガードが高温時に auto へ戻すので、色を常時見せる必要はない。
    "group/power": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 300,
        "children-class": "drawer-child",
        "transition-left-to-right": false,
        "click-to-reveal": true
      },
      "modules": ["custom/power-menu", "custom/fan", "power-profiles-daemon", "custom/power"]
    },
    // group/power の入口。クリック動作を持たせないこと (上のコメント参照)。
    // グリフは Nerd Font に実在するものを使うこと。⚙ のような一般記号は別フォント
    // にフォールバックして行ボックスが高くなり、バー高が 32 から 38 に膨らんだ。
    "custom/power-menu": {
      "format": "󰍜",
      "tooltip-format": "Power menu"
    },
    // ThinkPad のファンレベル切替。auto -> quiet -> max を巡回する。
    // 実体は thinkpad_acpi の hwmon (pwm1_enable / pwm1) で、書き込み権限は
    // udev/99-thinkpad-fan.rules が wheel に与える (リポジトリ管理だが
    // /etc/udev/rules.d/ への配置は手動。手順は README.md)。
    // 本体固有の機能なので eDP-1 のバーにだけ置く (group/power の中)。
    //
    // signal は custom/scroll 廃止 (b4e914d) 以降空いている 1 番を使う。
    // このモジュールが config に居ない状態で fan-profile.sh の
    // pkill -RTMIN+1 waybar を撃つと waybar が静かに死ぬので、片方だけ
    // 消さないこと。interval は tooltip の RPM 更新用で、signal と併用できる。
    "custom/fan": {
      "tooltip": true,
      "return-type": "json",
      "format": "{icon}",
      // アイコンは custom/caffeine と同じく config 側に持たせる。off と full は
      // 巡回に含めないが、他ツールや直接 echo でその状態になることがあるので
      // 独立したグリフを割り当てて quiet / max と取り違えないようにする。
      // 7 つとも HackGen Console NF が収録している (fc-list ":charset=<cp>")。
      "format-icons": {
        "auto":        "󱜝", // U+F171D nf-md-fan_auto
        "quiet":       "󱑳", // U+F1473 nf-md-fan_speed_2
        "max":         "󱑴", // U+F1474 nf-md-fan_speed_3
        "manual":      "󰈐", // U+F0210 nf-md-fan
        "off":         "󰠝", // U+F081D nf-md-fan_off
        "full":        "󱑮", // U+F146E nf-md-fan_chevron_up
        "unavailable": "󱑬"  // U+F146C nf-md-fan_alert
      },
      // fan_control パラメータの有無ではなく hwmon の実在を見る
      // (fan-profile.sh のパス解決と同じアンカー)。
      "exec-if": "test -d /sys/devices/platform/thinkpad_hwmon",
      "exec": "$HOME/.config/mango/bin/fan-profile.sh status",
      "interval": 5,
      "signal": 1,
      "on-click": "$HOME/.config/mango/bin/fan-profile.sh cycle",
      "on-click-right": "$HOME/.config/mango/bin/fan-profile.sh set auto",
      "escape": true
    },
    // noctalia の bar (eDP-1 の左端に縦置き) の表示/非表示トグル。bar を隠すと
    // bar 上のウィジェットからは戻せなくなるので、外側の waybar に入口を置く。
    //
    // 状態表示は付けていない。バーは目の前に見えているのでアイコンで重複して
    // 伝える価値が薄いのと、noctalia には bar 表示のフック ([hooks] は battery /
    // wifi / wallpaper 等だけ) も D-Bus プロパティ (dev.noctalia.Debug はログ制御
    // のみ) も無く、状態を追うには noctalia msg status の定期ポーリングしか手が
    // ないため。caffeine のような無ポーリング常駐は組めない。
    //
    // exec-if は exec を実行するかどうかしか見ないので、format だけの静的モジュール
    // では noctalia の有無を判定できない。アイコンを exec の出力にして
    // interval: once で起動時 1 回だけ実行させ、ポーリング無しで判定している
    // (exec-on-event が既定 true なので、クリックのたびに再判定もされる)。
    "custom/noctalia-bar": {
      "tooltip": true,
      "tooltip-format": "noctalia の bar を表示 / 非表示",
      "format": "{}",
      "exec-if": "which noctalia",
      // U+F06FD nf-md-page_layout_sidebar_left。HackGen Console NF が収録済み
      // (フォントの post テーブルで glyph 名を確認)。
      "exec": "echo 󰛽",
      "interval": "once",
      "on-click": "noctalia msg bar-toggle",
      "escape": true
    },
    // noctalia の caffeine (アイドル抑止) の状態表示とトグル。
    // noctalia のバーには状態表示を置かず、こちらに寄せている。
    // 状態は caffeine-status.sh が logind の inhibitor から読んで JSON で流す。
    "custom/caffeine": {
      "tooltip": true,
      "format": "<span size='12pt'>{icon}</span>",
      "format-icons": {
        "on": "☕",
        "off": "💤"
      },
      "return-type": "json",
      "exec-if": "which noctalia",
      "exec": "~/.config/mango/bin/caffeine-status.sh",
      "on-click": "noctalia msg caffeine-toggle",
      "escape": true
    },
   "custom/notification": {
      "tooltip": true,
      "format": "<span size='12pt'>{icon}</span>",
      "format-icons": {
        "notification": "🔔",
        // "none": "🈚",
        "none": "",
        "dnd-notification": "🔕",
        "dnd-none": "🔕",
        "inhibited-notification": "🔕",
        "inhibited-none": "🔕",
        "dnd-inhibited-notification": "🔕",
        "dnd-inhibited-none": "🔕",
      },
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "escape": true
    },
    "custom/power": {
      "tooltip-format": "Power Menu",
      "on-click": "wlogout & disown",
      "format": "󰐥"
    }
  },
]
